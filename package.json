{
  "name": "kuwo-desktop",
  "version": "1.2.7",
  "private": true,
  "type": "module",
  "description": "无我音乐：听歌、下载与音乐评论",
  "author": "LHL",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build": "node scripts/verify-separation-assets.mjs && tsc --noEmit && vite build && node scripts/build-main.mjs",
    "dev": "npm run build && electron .",
    "test": "tsx --test tests/*.test.ts",
    "verify:api": "tsx scripts/verify-api.ts",
    "package": "npm run build && electron-builder --win dir --x64",
    "package:dir": "npm run build && electron-builder --win dir --x64"
  },
  "dependencies": {
    "@soundtouchjs/audio-worklet": "2.1.1",
    "json5": "2.2.3",
    "lucide-react": "^0.577.0",
    "music-metadata": "^11.12.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "local.kuwo.desktop",
    "productName": "无我音乐",
    "artifactName": "无我音乐-${version}-win-x64.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "requestExecutionLevel": "user"
    },
    "extraResources": [
      {
        "from": "build/hifi",
        "to": "hifi",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/audio-effects",
        "to": "audio-effects",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/separation",
        "to": "separation",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
